{
  "mcpServers": {
    "intranet": {
      "command": "npx",
      "args": [
        "-y",
        "mcp-remote@0.15.2",
        "${MCP_URL:-https://mcp.localhost/mcp}",
        "--static-oauth-client-info",
        "{\"client_id\":\"${OAUTH_CLIENT_ID:-claude-desktop}\"}"
      ],
      "env": {
        "NODE_EXTRA_CA_CERTS": "${CA_CERT:-}"
      }
    }
  }
}
